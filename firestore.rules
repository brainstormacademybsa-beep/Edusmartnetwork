rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Schools Collection: Discovery, registration and portal configuration
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    // 2. Users Collection (School Admins, Teachers, Students, Parents)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 3. Student Results Collection
    match /results/{resultId} {
      allow read, write: if true;
    }

    // 4. CBT Exams & Questions
    match /cbt_exams/{examId} {
      allow read, write: if true;
    }

    // 5. CBT Attempts & Submissions
    match /cbt_attempts/{attemptId} {
      allow read, write: if true;
    }

    // 6. Online Admissions Applications
    match /admissions/{admissionId} {
      allow read, write: if true;
    }

    // 7. Result PINs (Scratch Cards)
    match /pins/{pinId} {
      allow read, write: if true;
    }

    // 8. Fee Schedules & Fee Payments
    match /fee_schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /fee_payments/{paymentId} {
      allow read, write: if true;
    }

    // 9. Audit Logs & Security Settings
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /security_settings/{schoolId} {
      allow read, write: if true;
    }
  }
}

